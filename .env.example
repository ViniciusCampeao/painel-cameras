PAINEL_USER=troque_este_usuario
PAINEL_SENHA=troque_esta_senha

CAM_COZINHA_HOST=192.168.0.10
CAM_COZINHA_USER=admin
CAM_COZINHA_SENHA=troque_esta_senha

CAM_GARAGEM_HOST=192.168.0.11
CAM_GARAGEM_USER=admin
CAM_GARAGEM_SENHA=troque_esta_senha

# Opcionais (valores padrão entre parênteses)
# GRAVACAO_DIR=/home/vinicius/gravacoes   pasta das gravações e do registro (troque para o HD externo quando montar)
# RETENCAO_HORAS=24                       quanto tempo cada gravação fica guardada
# SEGMENTO_S=300                          tamanho de cada arquivo de gravação, em segundos
# REGISTRO_GAP_S=30                       segundos sem ver pessoa para fechar um evento
# REGISTRO_CONFIANCA=0.45                 confiança mínima da detecção de pessoa
# MODELO_YOLO=yolo11s.pt                  modelo de detecção (yolo11s vence nas câmeras 360p)
# DETECTOR_IMGSZ=480                      resolução de inferência (480 casa com o 360p; 640 piora e custa mais)
